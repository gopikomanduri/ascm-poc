# ═══════════════════════════════════════════════════════════════════
# ASCM Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ── LLM Provider (Bring Your Own Key) ──────────────────────────────
# Choose ONE of the following providers:

# Option 1: Google Gemini (default, recommended)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# FAST_MODEL=gemini-1.5-flash

# Option 2: OpenAI / Azure OpenAI / DeepSeek / Groq (OpenAI-compatible)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# FAST_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# FAST_MODEL=claude-3-5-haiku-latest

# Option 4: Local / Offline (100% Free & Private via Ollama)
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:latest
# OLLAMA_FAST_MODEL=llama3.2:3b

# ── GitHub OAuth (for "Connect with GitHub" login button) ──────────
# Create at: github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: https://your-railway-url.railway.app
# Callback URL: https://your-railway-url.railway.app/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Session Security ────────────────────────────────────────────────
# Random 32+ character string for signing session cookies.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
ASCM_SECRET_KEY=

# ── Deployment ──────────────────────────────────────────────────────
# Railway / Render / Heroku set $PORT automatically — do not set this manually.
# PORT=8080

# ── Execution Security & Verification Sandboxing ───────────────────
# USE_DOCKER_SANDBOX=false

# ── Git Automation & Remote Pull Requests ──────────────────────────
# CREATE_PR=false
# AUTO_PUSH_REMOTE=false

# ── Lead Discovery (Fallback chain: OpenOutreach → Hunter.io → Apollo.io) ──
# Hunter.io Free Tier (25 req/mo — https://hunter.io)
# HUNTER_API_KEY=
# HUNTER_TARGET_DOMAIN=competitor.com

# Apollo.io Free Tier (50 exports/mo — https://app.apollo.io)
# APOLLO_API_KEY=

# NeverBounce email deliverability (optional)
# NEVERBOUNCE_API_KEY=

# ── CMS Publishing (Ghost → WordPress → Markdown fallback) ──────────────────
# Ghost CMS (Settings → Integrations → Custom Integration)
# GHOST_API_URL=https://your-blog.ghost.io
# GHOST_ADMIN_API_KEY=<id>:<secret>

# WordPress REST API (Application Passwords)
# WP_API_URL=https://your-site.com/wp-json/wp/v2
# WP_USERNAME=your-wp-username
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Outbound Email & Social ──────────────────────────────────────────────────
# SMARTLEAD_API_KEY=
# SMARTLEAD_DOMAIN=reply.smartlead.ai
# BUFFER_API_KEY=
# BUFFER_LINKEDIN_PROFILE_ID=
# BUFFER_TWITTER_PROFILE_ID=
