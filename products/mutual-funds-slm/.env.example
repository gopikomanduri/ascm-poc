# ─────────────────────────────────────────────────────────────────────────────
# Mutual Funds SLM Production Environment Variables
# Copy this file to .env and fill in production broker/custodian credentials:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
SLM_PORT=8095
PYTHONUNBUFFERED=1

# Local SLM Neural Engine (Ollama / vLLM)
OLLAMA_API_BASE=http://ollama:11434
OLLAMA_MODEL=phi4-mini:latest

# Macro & Calculation Parameters
RISK_FREE_RATE=0.065
SYNC_INTERVAL=86400

# ── Multi-Broker Production API Credentials ──────────────────────────────────
# 1. Zerodha Kite Connect (https://kite.trade)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# 2. Angel One SmartAPI (https://smartapi.angelbroking.com)
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_KEY=

# 3. Upstox Developer API (https://upstox.com/developer/api-documentation)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://your-domain.com/api/broker/callback/upstox

# 4. DhanHQ API (https://dhanhq.co)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# 5. RBI Account Aggregator (AA) Gateway (Setu / Finvu / Anumati / Sahamati)
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_GATEWAY_URL=https://fiu-uat.setu.co
