[Unit]
Description=Mutual Funds SLM Web Copilot & REST API Serving Engine
After=network.target ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ascm-poc/products/mutual-funds-slm
Environment=PYTHONPATH=/opt/ascm-poc/products/mutual-funds-slm/data-pipeline:/opt/ascm-poc/products/mutual-funds-slm/data-pipeline/app:/opt/ascm-poc/products/mutual-funds-slm/slm-serving-engine/app
Environment=SLM_PORT=8095
Environment=OLLAMA_API_BASE=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=phi4-mini:latest
ExecStart=/opt/ascm-poc/.venv/bin/python /opt/ascm-poc/products/mutual-funds-slm/slm-serving-engine/app/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
