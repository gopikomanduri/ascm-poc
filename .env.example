# Bring Your Own Key (BYOK) - Set any of the following providers:

# Option 1: Google Gemini (default)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# FAST_MODEL=gemini-1.5-flash

# Option 2: OpenAI / Azure OpenAI / DeepSeek / Groq (OpenAI-compatible)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# FAST_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Anthropic Claude (Claude 3.5 Sonnet / Haiku)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# FAST_MODEL=claude-3-5-haiku-latest

# Option 4: Local / Offline Open-Source Models via Ollama (100% Free & Private)
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:latest
# OLLAMA_FAST_MODEL=llama3.2:3b

# Execution Security & Verification Sandboxing
# USE_DOCKER_SANDBOX=false

# Git Automation & Remote Pull Requests
# CREATE_PR=false
# AUTO_PUSH_REMOTE=false

